{
  "name": "mobile-automation-webdriverio",
  "version": "1.0.0",
  "description": "Automação de testes mobile com WebdriverIO, Appium e BrowserStack",
  "main": "index.js",
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "test:browserstack": "wdio run ./config/wdio.browserstack.conf.js",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "allure:generate": "allure generate allure-results --clean",
    "allure:open": "allure open allure-report",
    "allure:clean": "rimraf allure-results allure-report"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "mocha",
    "mobile",
    "automation",
    "browserstack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@wdio/allure-reporter": "^8.29.1",
    "@wdio/appium-service": "^8.29.1",
    "@wdio/browserstack-service": "^8.29.1",
    "@wdio/cli": "^8.29.1",
    "@wdio/local-runner": "^8.29.1",
    "@wdio/mocha-framework": "^8.29.1",
    "@wdio/spec-reporter": "^8.29.1",
    "allure-commandline": "^2.25.0",
    "appium": "^2.4.1",
    "appium-uiautomator2-driver": "^2.41.2",
    "appium-xcuitest-driver": "^5.12.2",
    "chai": "^4.3.10",
    "rimraf": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
